{
  "name": "portfolio",
  "main": "main.py",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "python_workers"
  ],
  "run_worker_first": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}